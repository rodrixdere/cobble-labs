node_modules/
.next/
out/
.env*
*.tsbuildinfo
next-env.d.ts

# Los datos generados SI se versionan, aunque salgan de `npm run extraer` y
# `npm run retratos`. Sin ellos el build falla, y el servidor que construye no
# tiene la instancia de Minecraft de donde salen: es la unica forma de que
# Cloudflare pueda compilar en cada push, y de que alguien que clone el repo
# pueda correrlo sin tener Cobblemon instalado.

# El zip del pack de iconos no, que son 12 MB y solo sirve para regenerarlos.
.cache/

# Rutas a la instancia local de Minecraft. Cambian en cada maquina.
scripts/rutas.local.json

# Salida de `next build` con output: "export".
out/

# Estado local de wrangler.
.wrangler/

# Secretos locales de wrangler. Los de produccion viven en Cloudflare.
.dev.vars*
